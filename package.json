{
  "name": "atfi-memnu-app",
  "version": "2.13.6",
  "description": "Citation Search and Verification App",
  "author": "temasictfic",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:backend": "pwsh -ExecutionPolicy Bypass -File ./scripts/build-backend.ps1",
    "release:tag": "pwsh -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "pack": "npm run build:backend && npm run build && electron-builder --dir",
    "dist:win": "npm run build:backend && npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.20",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  }
}
